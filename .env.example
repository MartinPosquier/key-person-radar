# Copy to .env in each worktree. Never commit .env.
# Shared data folder, the SAME for every worktree, outside any git checkout.
KPR_DATA_DIR=C:\dev\kpr-data-store
# Google Cloud project used for BigQuery (GDELT). Set a billing cap at 0.
GCP_PROJECT=
# Generic team contact for HTTP User-Agent headers (Wikipedia, SEC EDGAR).
HTTP_CONTACT=
# Optional: force the session name (data | quant | ml | main). Normally detected from the folder name.
KPR_SESSION=
# Set to 1 to make kpr.utils.io.read_table read the synthetic fixtures in tests/fixtures/.
KPR_USE_FIXTURES=0
